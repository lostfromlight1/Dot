/* --- Configuration --- */
configuration {
    modi:                        "drun";
    show-icons:                  false;
    font:                        "JetBrainsMono Nerd Font 10";
}

/* --- Color Mapping --- */
@import "~/.config/rofi/colors.rasi"

* {
    main-bg:   @background-alt;
    main-fg:   @foreground;      
    main-br:   @selected;        
    
    /* Frosted glass highlight for selected items */
    select-bg: rgba(255, 255, 255, 0.05); 
    select-fg: @foreground;
    
    /* Darker background for the search bar */
    surface0:  #313244; 
}

/* --- Main Window --- */
window {
    height:                      50%;
    width:                       60%;
    transparency:                "real";
    fullscreen:                  false;
    enabled:                     true;
    cursor:                      "default";
    spacing:                     0px;
    padding:                     0px;
    border:                      2px;
    border-radius:               12px;
    border-color:                @main-br;
    background-color:            rgba(30, 30, 46, 0.85); 
}

mainbox {
    enabled:                     true;
    spacing:                     0px;
    orientation:                 horizontal;
    children:                    [ "dummy", "listbox" ];
    background-color:            transparent;
}

/* --- Left Pane (Wallpaper Image) --- */
dummy {
    width:                       25%;
    expand:                      false;
    background-color:            transparent;
    background-image:            url("~/.config/swww/wall.rofi", height);
    
    margin:                      15px;
    border-radius:               10px;
    border:                      0px;
}

/* --- Right Pane (Search & Clipboard Items) --- */
listbox {
    spacing:                     15px;
    width:                       75%;
    padding:                     15px 15px 15px 0px; 
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "inputbar", "listview" ];
}

/* --- Input Bar (Search) --- */
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     12px 15px;
    border-radius:               8px;
    background-color:            @surface0;
    text-color:                  @main-fg;
    children:                    [ "entry" ];
    border:                      0px;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Search clipboard...";
    placeholder-color:           inherit;
}

/* --- Listview --- */
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    spacing:                     5px;
    background-color:            transparent;
    text-color:                  @main-fg;
    cursor:                      "default";
    border:                      0px; 
}

/* --- Elements (Clipboard Items) --- */
element {
    enabled:                     true;
    spacing:                     15px;
    padding:                     10px 15px;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  @main-fg;
    cursor:                      pointer;
    border:                      0px;
}

element normal.normal,
element alternate.normal {
    background-color:            transparent;
    text-color:                  @main-fg;
}

element selected.normal {
    background-color:            @select-bg;
    text-color:                  @select-fg;
}

element-text {
    vertical-align:              0.5;
    horizontal-align:            0.0;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
}
